# Скопируйте в .env или задайте переменные среды перед запуском.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=False  # Для локальной разработки можно временно установить True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Для публикации замените список доменов и настройте HTTPS на сервере.
